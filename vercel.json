{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && npm ci",
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR BUILD_DIR && npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{dist/rsc/**,dist/ssr/**,public/images/**,public/brand/**}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": { "X-Content-Type-Options": "nosniff" },
      "continue": true
    },
    {
      "src": "/sw[\\w.-]*\\.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "header", "key": "rsc", "value": "1" }],
      "dest": "/api/index"
    },
    {
      "src": "/(.*)",
      "methods": ["POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "dest": "/api/index"
    },
    {
      "src": "/(kg|ru|en)/offline/?",
      "methods": ["GET", "HEAD"],
      "dest": "/$1/offline/index.html"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
