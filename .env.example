# Local PostgreSQL connection. Keep credentials in .env only.
# USER and PASSWORD below are placeholders. Use your local PostgreSQL credentials.
# Local PostgreSQL normally runs without TLS. Use sslmode=require for hosted servers.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/a_frame_kg?schema=public&sslmode=disable"
# Durable writable storage for cabin images on a self-hosted server.
UPLOAD_DIR=".uploads"
# Optional commercial showcase: true enables demo properties; false hides them.
# Without this variable, demos are visible only in Vite development mode.
DEMO_MODE=""
# Private values used only by npm run db:create-admin. No default credentials.
ADMIN_EMAIL="admin@frame.kg"
ADMIN_PASSWORD=""
ADMIN_PHONE="0556201008"
ADMIN_NAME="Admin.frame.kg"
ADMIN_ROLE="ADMIN"
# Server-only Telegram credentials. TELEGRAMM_KEY is also accepted for existing setups.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Generate once: 32 random bytes as 64 hex characters. Never expose to the browser.
ADMIN_OTP_SECRET=""

# Server-only Google OAuth credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional canonical origin, e.g. https://your-domain.com.
APP_URL=""

# Finik Pay: fixed charge of 5 KGS, independent of database prices.
FINIK_ENV="beta"
FINIK_API_KEY=""
FINIK_ACCOUNT_ID=""
# Required for FINIK_ENV=prod; PEM supports multiline values or escaped \n.
FINIK_PRIVATE_KEY=""
# Public application origin for Finik webhook and return redirect.
# NEXTAUTH_URL takes precedence; APP_URL or the request origin is the fallback.
NEXT_PUBLIC_APP_URL=""

# A-FRAME KG assistant: server-only. Choose ollama, groq, or faq.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
# Use a Groq Free Plan account; the app does not enable billing or switch providers.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
AI_TIMEOUT_MS="45000"
# Enable only behind a proxy that overwrites X-Forwarded-For.
AI_TRUST_PROXY="false"
