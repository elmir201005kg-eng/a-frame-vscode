{
  "name": "a-frame-vscode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  },
  "scripts": {
    "dev": "vite --configLoader runner --port 3001",
    "prebuild": "prisma generate && node scripts/generate-pwa-icons.mjs",
    "build": "vite build --configLoader runner",
    "postbuild": "node scripts/build-pwa.mjs",
    "start": "node server/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "clean:legacy": "node scripts/clean-legacy.mjs",
    "audit:navigation": "node scripts/navigation-audit.mjs",
    "audit:database": "node --conditions=react-server --import tsx scripts/database-audit.mjs",
    "test:auth": "playwright test",
    "test:runtime": "node --conditions=react-server --import tsx --test tests/runtime.test.ts",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:dependencies": "node --test tests/dependencies.test.mjs",
    "test:admin": "node scripts/admin-qa.mjs",
    "test:finik": "node --conditions=react-server --import tsx --test tests/finik.test.ts",
    "test:demo-checkout": "node scripts/demo-checkout-qa.mjs",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai.test.ts",
    "test:ai:ui": "playwright test --config playwright.ai.config.ts",
    "test:performance": "node scripts/performance-qa.mjs",
    "test:forms": "node scripts/forms-qa.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:demo": "npm run db:seed && tsx prisma/seed-demo.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@mancho.devs/authorizer": "2.12.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "dotenv": "18.0.7",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.56.0",
    "node-domexception": "file:./packages/native-domexception",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "rsc-html-stream": "0.0.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "uuid": "file:./packages/native-uuid"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.9.1",
    "typescript-eslint": "^8",
    "eslint-plugin-react-hooks": "^7",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.3.5"
  },
  "overrides": {
    "node-jose": {
      "uuid": "$uuid"
    },
    "fetch-blob": {
      "node-domexception": "$node-domexception"
    }
  }
}
