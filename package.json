{
  "name": "a-frame-vscode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "next build",
    "postbuild": "node scripts/build-pwa.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "playwright test",
    "test:admin": "node scripts/admin-qa.mjs",
    "test:finik": "node --conditions=react-server --import tsx --test tests/finik.test.ts",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai.test.ts",
    "test:ai:ui": "playwright test --config playwright.ai.config.ts",
    "test:performance": "node scripts/performance-qa.mjs",
    "test:forms": "node scripts/forms-qa.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:demo": "npm run db:seed && tsx prisma/seed-demo.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@mancho.devs/authorizer": "2.12.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "dotenv": "18.0.7",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
